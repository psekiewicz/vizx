@@ -384,6 +384,11 @@ void ProjectM::SetEasterEgg(float value)
     m_timeKeeper->ChangeEasterEgg(value);
 }
 
+void ProjectM::SetFrameTime(double secondsSinceFirstFrame)
+{
+    m_timeKeeper->SetFrameTime(secondsSinceFirstFrame);
+}
