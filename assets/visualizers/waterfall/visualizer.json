{
    "name": "Waterfall",
    "author": "VizX",
    "description": "A scrolling spectrogram: each row is the spectrum of one moment, the newest at the edge.",
    "parameters": [
        { "id": "gain", "name": "Brightness", "kind": "number", "min": 0.3, "max": 2.5, "default": 1.0 },
        { "id": "span", "name": "History length", "kind": "number", "min": 0.1, "max": 1.0, "default": 1.0 },
        { "id": "color_low", "name": "Quiet color", "kind": "color", "default": [0.1, 0.0, 0.5] },
        { "id": "color_high", "name": "Loud color", "kind": "color", "default": [1.0, 0.35, 0.0] },
        { "id": "rising", "name": "Flow upwards", "kind": "toggle", "default": false },
        { "id": "see_through", "name": "Transparent where quiet", "kind": "toggle", "default": true }
    ]
}