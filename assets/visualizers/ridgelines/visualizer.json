{
    "name": "Ridgelines",
    "author": "VizX",
    "description": "The spectrum of the last seconds as rows of mountain lines, one behind the other, the newest in front, like a famous album cover. Each row hides the ones behind it.",
    "parameters": [
        { "id": "lines", "name": "Lines", "kind": "number", "min": 8, "max": 64, "default": 36, "step": 1 },
        { "id": "height", "name": "Peak height", "kind": "number", "min": 0.02, "max": 0.6, "default": 0.22 },
        { "id": "history", "name": "Seconds shown", "kind": "number", "min": 0.1, "max": 1.0, "default": 0.5 },
        { "id": "thickness", "name": "Line thickness", "kind": "number", "min": 0.5, "max": 6.0, "default": 1.6 },
        { "id": "fill", "name": "Hide lines behind", "kind": "number", "min": 0.0, "max": 1.0, "default": 1.0 },
        { "id": "color_front", "name": "Front color", "kind": "color", "default": [1.0, 1.0, 1.0] },
        { "id": "color_back", "name": "Back color", "kind": "color", "default": [0.35, 0.4, 0.9] },
        { "id": "color_fill", "name": "Fill color", "kind": "color", "default": [0.0, 0.0, 0.0] }
    ]
}
