{
    "name": "Beat Burst",
    "author": "VizX",
    "description": "Every beat throws a burst of sparks and a shockwave ring out of the middle; the sparks slow down, fade and leave trails. Strong beats throw them further. The background stays transparent.",
    "parameters": [
        { "id": "sparks", "name": "Sparks", "kind": "number", "min": 4, "max": 96, "default": 40, "step": 1 },
        { "id": "reach", "name": "Reach", "kind": "number", "min": 0.1, "max": 2.0, "default": 0.9 },
        { "id": "size", "name": "Spark size", "kind": "number", "min": 0.3, "max": 3.0, "default": 1.0 },
        { "id": "ring", "name": "Shockwave", "kind": "number", "min": 0.0, "max": 1.0, "default": 0.7 },
        { "id": "trail", "name": "Trails", "kind": "number", "min": 0.0, "max": 0.97, "default": 0.85 },
        { "id": "color", "name": "Color", "kind": "color", "default": [1.0, 0.6, 0.2] },
        { "id": "color_ring", "name": "Ring color", "kind": "color", "default": [0.4, 0.8, 1.0] }
    ]
}
